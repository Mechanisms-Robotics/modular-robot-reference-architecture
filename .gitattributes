# Normalize all text files to LF in the repository and working tree.
# Main historically had CRLF files committed from Windows machines, which made
# every edit show up as a whole-file diff. Keep everything LF so diffs are real.
* text=auto eol=lf

# Windows-only scripts must keep CRLF to run correctly.
*.bat text eol=crlf

# Binary assets — never diff or normalize.
*.png binary
*.jpg binary
*.glb binary
*.wpilog binary
gradle/wrapper/gradle-wrapper.jar binary
